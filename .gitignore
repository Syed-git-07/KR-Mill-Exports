# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519

# local editor and operating-system configuration
/.vscode/
/.idea/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (never commit real values; keep only the template)
.env*
!.env.example

# local credentials and package-manager authentication
credentials.json
*-credentials.json
secrets.json
*-secrets.json
service-account*.json
.npmrc
.netrc

# local databases, database exports, and backups
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.bak
*.backup
*.sql.gz
*.sql.zip
/backups/
/data/
/storage/

# data-bearing SQL exports (keep schema migrations versioned)
/schema/*-db.sql
/schema/kr_production-*.sql
/schema/*_mock_data.sql

# user-generated/runtime files
/uploads/
*.log
*.pid
*.pid.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
