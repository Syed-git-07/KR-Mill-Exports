# MySQL connection used by Prisma. Never use root. For multiple app processes,
# divide the server's connection budget across processes with connection_limit.
DATABASE_URL="mysql://kr_app:replace-with-a-long-random-password@127.0.0.1:3306/production2?connection_limit=10&pool_timeout=10&connect_timeout=5"

# Comma-separated public HTTPS origins accepted for state-changing requests.
AUTH_TRUSTED_ORIGINS="https://example.com"

# Production cookies are always Secure. Set this only to exercise Secure cookies locally.
AUTH_COOKIE_SECURE="false"

# Set false only if the high-volume server-action audit entries are not required.
AUDIT_SERVER_ACTIONS="true"

# Audit cleanup retention. Minimum enforced value is 30 days.
LOG_RETENTION_DAYS="365"

NEXT_PUBLIC_APP_NAME="NAME"
NEXT_PUBLIC_COMPANY_NAME="NAME"

# Build-time deployment path. Use an empty value when serving at the domain root.
NEXT_PUBLIC_BASE_PATH="/path"

# SMTP Settings for DB Backup Emails
SMTP_USER="your_email@example.com"
SMTP_PASS="your_app_password"

