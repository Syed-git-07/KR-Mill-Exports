/// Application identities are intentionally separate from production employees.
/// Passwords are stored only as versioned scrypt hashes.
model app_users {
  id                   String          @id @default(uuid()) @db.Char(36)
  username             String          @unique(map: "uq_app_users_username") @db.VarChar(64)
  display_name         String          @db.VarChar(120)
  password_hash        String          @db.VarChar(255)
  role                 String          @default("OPERATOR") @db.VarChar(20)
  is_active            Boolean         @default(true)
  must_change_password Boolean         @default(true)
  failed_login_count   Int             @default(0)
  locked_until         DateTime?
  password_changed_at  DateTime?
  last_login_at        DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @default(now()) @updatedAt
  audit_logs           audit_logs[]
  sessions             auth_sessions[]

  @@index([is_active], map: "idx_app_users_active")
}

/// Only a SHA-256 digest of the browser session token is persisted.
model auth_sessions {
  id           String    @id @default(uuid()) @db.Char(36)
  user_id      String    @db.Char(36)
  token_hash   String    @unique(map: "uq_auth_sessions_token_hash") @db.Char(64)
  ip_address   String?   @db.VarChar(64)
  user_agent   String?   @db.VarChar(512)
  expires_at   DateTime
  last_seen_at DateTime  @default(now())
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  user         app_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at, expires_at], map: "idx_auth_sessions_user_status")
  @@index([expires_at], map: "idx_auth_sessions_expiry")
}

/// Security and administrative events. Sensitive values must never be written here.
model audit_logs {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  occurred_at DateTime   @default(now())
  user_id     String?    @db.Char(36)
  username    String?    @db.VarChar(64)
  event_type  String     @db.VarChar(64)
  outcome     String     @db.VarChar(20)
  action      String     @db.VarChar(120)
  resource    String?    @db.VarChar(255)
  request_id  String?    @db.VarChar(64)
  ip_address  String?    @db.VarChar(64)
  user_agent  String?    @db.VarChar(512)
  details     Json?
  user        app_users? @relation(fields: [user_id], references: [id])

  @@index([occurred_at], map: "idx_audit_logs_occurred")
  @@index([user_id, occurred_at], map: "idx_audit_logs_user_occurred")
  @@index([event_type, occurred_at], map: "idx_audit_logs_event_occurred")
  @@index([outcome, occurred_at], map: "idx_audit_logs_outcome_occurred")
}

/// Persistent throttling data protects login even after an application restart.
model login_attempts {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username       String   @db.VarChar(64)
  ip_address     String   @db.VarChar(64)
  was_successful Boolean  @default(false)
  attempted_at   DateTime @default(now())

  @@index([username, attempted_at], map: "idx_login_attempts_username_time")
  @@index([ip_address, attempted_at], map: "idx_login_attempts_ip_time")
}
