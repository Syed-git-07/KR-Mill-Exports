generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model shift_config {
  id              String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  department_code String    @db.VarChar(50)
  shift           Int
  shift_name      String?   @default("Day") @db.VarChar(50)
  shift_time      Int       @default(510)
  start_time      DateTime? @db.Time(0)
  end_time        DateTime? @db.Time(0)
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @default(now()) @updatedAt @db.DateTime(0)

  @@unique([department_code, shift], name: "uk_dept_shift", map: "uk_dept_shift")
}

model autoconer_machine_setup {
  id                 String             @id @default(dbgenerated("(uuid())")) @db.Char(36)
  run_sequence       Int                @default(1)
  machine_id         String             @db.Char(36)
  count_name         String?            @db.VarChar(100)
  count_id           String?            @db.Char(36)
  act_count          Decimal?           @default(69.50) @db.Decimal(10, 2)
  session_no         Int?               @default(1)
  run_time           Int?               @default(510)
  created_at         DateTime?          @default(now()) @db.DateTime(0)
  updated_at         DateTime?          @default(now()) @db.DateTime(0)
  entry_date         DateTime           @default(dbgenerated("'1970-01-01'")) @db.Date
  shift              Int                @default(1)
  speed              Int?               @default(1200)
  target_effi        Decimal?           @db.Decimal(5, 2)
  is_included        Boolean            @default(true)
  spinning_counts    spinning_counts?   @relation(fields: [count_id], references: [id], onDelete: Restrict, map: "fk_ac_setup_count")
  autoconer_machines autoconer_machines @relation(fields: [machine_id], references: [id], map: "fk_ac_setup_machine")

  @@unique([machine_id, entry_date, shift, run_sequence], name: "idx_autoconer_machine_setup_date")
  @@index([entry_date, shift], map: "idx_autoconer_setup_date_shift")
  @@index([count_id], map: "fk_ac_setup_count")
}

model autoconer_machines {
  id                          String                        @id @default(dbgenerated("(uuid())")) @db.Char(36)
  machine_no                  String                        @db.Text
  description                 String                        @db.Text
  make_name                   String                        @default("MURT") @db.VarChar(255)
  act_effi                    Int?                          @default(0)
  is_active                   Boolean?                      @default(true)
  created_at                  DateTime?                     @default(now()) @db.DateTime(0)
  updated_at                  DateTime?                     @default(now()) @db.DateTime(0)
  mc_id                       Int?
  group_id                    Int?                          @default(1)
  model                       String?                       @db.Text
  from_drum                   Int?
  to_drum                     Int?
  no_of_drums                 Int?                          @default(0)
  speed                       Int?
  count                       String?                       @db.Text
  count_id                    String?                       @db.Char(36)
  installed_date              DateTime?                     @db.Date
  direct_prod_entry           Boolean?                      @default(false)
  activated_at                DateTime?                     @db.Date
  deactivated_at              DateTime?                     @db.Date
  active_machine_no           String?                       @unique(map: "uq_autoconer_active_machine_no") @db.VarChar(255)
  spinning_counts             spinning_counts?              @relation(fields: [count_id], references: [id], onDelete: Restrict, map: "fk_autoconer_machine_count")
  autoconer_machine_setup     autoconer_machine_setup[]
  autoconer_production_detail autoconer_production_detail[]

  @@index([count_id], map: "fk_autoconer_machine_count")
}

model autoconer_production_detail {
  id                          String                      @id @default(dbgenerated("(uuid())")) @db.Char(36)
  run_sequence                Int                         @default(1)
  header_id                   String                      @db.Char(36)
  machine_id                  String                      @db.Char(36)
  emp_name                    String?                     @db.VarChar(100)
  count_name                  String?                     @db.VarChar(100)
  count_id                    String?                     @db.Char(36)
  act_prodn                   Decimal?                    @default(0.00) @db.Decimal(10, 2)
  prodn_effi                  Decimal?                    @default(0.00) @db.Decimal(5, 2)
  red_light                   Decimal?                    @default(0.00) @db.Decimal(5, 2)
  idle_drum                   Int?                        @default(0)
  idle_reason                 String?                     @db.Text
  waste_kg                    Decimal?                    @db.Decimal(10, 4)
  waste_percent               Decimal?                    @db.Decimal(5, 2)
  total_stoppage_mins         Int?                        @default(0)
  work_time                   Int?                        @default(510)
  run_time                    Int?                        @default(510)
  session_no                  Int?                        @default(1)
  is_verified                 Boolean?                    @default(false)
  created_at                  DateTime?                   @default(now()) @db.DateTime(0)
  updated_at                  DateTime?                   @default(now()) @db.DateTime(0)
  spinning_counts             spinning_counts?            @relation(fields: [count_id], references: [id], onDelete: Restrict, map: "fk_ac_detail_count")
  autoconer_production_header autoconer_production_header @relation(fields: [header_id], references: [id], onDelete: Cascade, map: "fk_ac_detail_header")
  autoconer_machines          autoconer_machines          @relation(fields: [machine_id], references: [id], map: "fk_ac_detail_machine")
  autoconer_stoppage_entry    autoconer_stoppage_entry[]

  @@unique([header_id, machine_id, run_sequence], name: "uq_autoconer_detail_header_machine")
  @@index([header_id, machine_id], map: "idx_autoconer_detail_header_machine")
  @@index([count_id], map: "fk_ac_detail_count")
  @@index([machine_id], map: "fk_ac_detail_machine")
}

